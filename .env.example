# ============================================================
# 智慧城市神经末梢 — 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================================

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://drainage_admin:YOUR_PASSWORD@localhost:5432/smart_drainage
DATABASE_URL_SYNC=postgresql://drainage_admin:YOUR_PASSWORD@localhost:5432/smart_drainage

# --- InfluxDB ---
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=smart-city
INFLUXDB_BUCKET=sensor_data

# --- Redis ---
REDIS_URL=redis://:YOUR_PASSWORD@localhost:6379/0

# --- JWT ---
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- YOLO Model ---
MODEL_STORAGE_PATH=./models/weights
DEFAULT_MODEL_VERSION=v1
MODEL_INFERENCE_DEVICE=cpu

# --- Media ---
HLS_OUTPUT_DIR=./backend/media/hls
SCREENSHOT_DIR=./backend/media/screenshots

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- FFmpeg ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Logging ---
LOG_LEVEL=INFO

# --- Notification ---
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@smartcity.local
WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URLS=[]
ALERT_EMAIL_RECIPIENTS=[]
