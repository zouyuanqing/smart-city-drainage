# ============================================================
# 智慧城市神经末梢 — 环境变量配置模板
# 复制为项目根目录 .env；所有值由 pydantic-settings 解析。
# 列表使用 JSON 数组；空的可选能力配置保持为空。
# 加载顺序与进程工作目录无关：
#   1) SCN_ENV_FILE 指向的文件（若设置）；
#   2) 项目根目录 .env；
#   3) backend/.env（仅当根目录没有 .env 时）。
# 因此 `cd backend && uvicorn app.main:app` 同样会读取项目根 .env。
# ============================================================

# --- Deployment / PostgreSQL ---
DEPLOYMENT_ENVIRONMENT=development
APP_NAME=Smart City Neural Endpoints
APP_VERSION=1.0.0
DATABASE_URL=postgresql+asyncpg://drainage_admin:YOUR_PASSWORD@localhost:5432/smart_drainage
DATABASE_URL_SYNC=postgresql://drainage_admin:YOUR_PASSWORD@localhost:5432/smart_drainage
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# --- Hydraulic storage and task roots ---
# portable 仅表示无 PostGIS（WKT+bbox）；仍使用 PostgreSQL + TimescaleDB。
HYDRAULIC_SPATIAL_BACKEND=portable
HYDRAULIC_SCHEMA_REVISION=0008_hydraulic_retention_seed
HYDRAULIC_IMPORT_ROOT=./backend/hydraulic/import
HYDRAULIC_SANDBOX_ROOT=./backend/hydraulic/sandbox
HYDRAULIC_EXPORT_ROOT=./backend/hydraulic/export
HYDRAULIC_ARTIFACT_ROOT=./backend/hydraulic/artifacts

# --- Simulation queue, limits and retention ---
# 契约硬上限：并发固定 2、attempt 超时 600s、取消轮询 1s、最多 3 次 attempt、
# workspace/frame/output 只能小于等于 2 GiB / 64 MiB / 8 GiB。越界值启动即失败。
SIM_GLOBAL_CONCURRENCY=2
SIM_NOWCAST_RESERVED_SLOTS=1
SIM_ATTEMPT_TIMEOUT_SECONDS=600
SIM_MAX_ATTEMPTS=3
SIM_RETRY_BACKOFF_SECONDS=[10, 60]
SIM_LEASE_SECONDS=30
SIM_HEARTBEAT_SECONDS=10
SIM_CANCEL_POLL_SECONDS=1
SIM_INPUT_MAX_BYTES=20971520
SIM_WORKSPACE_MAX_BYTES=2147483648
SIMULATION_FRAME_MAX_BYTES=67108864
SIMULATION_OUTPUT_MAX_BYTES=8589934592
SIMULATION_RESULT_RETENTION_DAYS=90

# --- Solvers ---
# EPA SWMM 是可选外部可执行程序；三个 EPA 变量必须同时为空或同时配置。
# auto 模式在提交时 probe（可执行文件存在 + 版本格式 + SHA-256 一致），
# 校验不通过时冻结为 py_mw，不会在运行中静默换求解器。
SOLVER_DEFAULT_SELECTION=auto
EPA_SWMM_EXECUTABLE=
EPA_SWMM_VERSION=
EPA_SWMM_SHA256=
MAX_SUBSTEPS_PER_REPORT=20
COURANT_LIMIT=0.5

# --- Nowcast and forecast ---
NOWCAST_INTERVAL_MINUTES=10
NOWCAST_HORIZON_MINUTES=120
NOWCAST_STEP_MINUTES=5
NOWCAST_DEADLINE_SECONDS=180
NOWCAST_MAX_RETRIES=2
NOWCAST_RETRY_BACKOFF_SECONDS=[5, 15]
NOWCAST_RESERVED_SLOT_BORROWING=false
FORECAST_EVENT_WINDOW_MINUTES=30
FORECAST_FRESH_MAX_AGE_SECONDS=900
FORECAST_REPLAY_RETENTION_HOURS=168
FORECAST_SSE_QUEUE_SIZE=256
FORECAST_POLICY_CONFIG_PATH=

# --- Network jobs ---
NETWORK_JOB_GLOBAL_CONCURRENCY=2
NETWORK_JOB_ATTEMPT_TIMEOUT_SECONDS=600
NETWORK_JOB_LEASE_SECONDS=30
NETWORK_JOB_HEARTBEAT_SECONDS=10
NETWORK_JOB_MAX_ATTEMPTS=3
NETWORK_JOB_RETRY_BACKOFF_SECONDS=[10, 60]
NETWORK_INPUT_MAX_BYTES=20971520

# --- Auth ---
JWT_ALGORITHMS=["HS256", "RS256"]
JWT_ISSUER=smart-city-drainage
JWT_AUDIENCE=smart-city-api
AUTH_FALLBACK_ADMIN_ENABLED=false

# --- Rate limits ---
RATE_LIMIT_FORECAST_READ_PER_MINUTE=120
RATE_LIMIT_FORECAST_TRANSITION_PER_MINUTE=30
RATE_LIMIT_SIMULATION_SUBMIT_PER_MINUTE=20
RATE_LIMIT_NETWORK_JOB_SUBMIT_PER_MINUTE=10
RATE_LIMIT_SSE_CONNECT_PER_MINUTE=30

# --- Notifications ---
NOTIFICATION_MAX_ATTEMPTS=5

# --- Preserve-only (do not change) ---
DEBUG=false
LOG_LEVEL=INFO
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=scn-influx-token-2024-secure
INFLUXDB_ORG=smart-city
INFLUXDB_BUCKET=sensor_data
REDIS_URL=redis://:R3d1s_S3cur3_2024!@localhost:6379/0
REDIS_CHANNEL_ALERTS=scn:alerts
REDIS_CHANNEL_SENSOR=scn:sensor_data
REDIS_CHANNEL_MODEL=scn:model_status
JWT_SECRET_KEY=scn-jwt-secret-key-change-in-production-2024
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MODEL_STORAGE_PATH=./models/weights
DEFAULT_MODEL_VERSION=v1
MODEL_INFERENCE_DEVICE=cuda:0
MODEL_CONFIDENCE_THRESHOLD=0.45
MODEL_IOU_THRESHOLD=0.45
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
HLS_OUTPUT_DIR=./backend/media/hls
SCREENSHOT_DIR=./backend/media/screenshots
HLS_SEGMENT_TIME=4
HLS_LIST_SIZE=6
MAX_ACTIVE_STREAMS=4
MAX_ACTIVE_INFERENCE_WORKERS=4
MEDIA_CONNECT_TIMEOUT_SECONDS=5
MEDIA_READ_TIMEOUT_SECONDS=10
STREAM_HEARTBEAT_INTERVAL=30
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=100
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@smartcity.local
WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URLS=[]
ALERT_EMAIL_RECIPIENTS=[]
