          }
        },
        {
          "method": "GET",
          "path": "/api/simulations/55555555-5555-4555-8555-555555555555/compare/66666666-6666-4666-8666-666666666666",
          "headers": {
            "authorization": "Bearer e2e-operator-token"
          }
        },
        {
          "method": "GET",
          "path": "/api/simulations/66666666-6666-4666-8666-666666666666/frames"
        },
        {
          "method": "GET",
          "path": "/api/simulations/66666666-6666-4666-8666-666666666666/frames/0"
        },
        {
          "method": "GET",
          "path": "/api/forecast/events",
          "query": {
            "network_id": "11111111-1111-4111-8111-111111111111"
          },
          "headers": {
            "authorization": "Bearer e2e-operator-token",
            "accept": "text/event-stream"
          }
        }
      ],
      "forbidden_requests": []
