            "rainfall_scenario_id": "99999999-9999-4999-8999-999999999998",
            "parameter_set_id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
            "duration_seconds": 86400,
            "frame_interval_seconds": 300,
            "ponding_enabled": true,
            "strict_stability": true,
