; Lock the verified toolchain (see .node-version: Node 18.20.8 / npm 10.8.2).
; Without engine-strict, npm only warns (EBADENGINE) and installs on unsupported
; Node/npm versions.  The package.json engines fields contain the same pins.
; Evidence (see README FAQ 0.1): npm ci + npm test + npm run build pass on
; Node 18.20.8/npm 10.8.2, while Node 25.9.0/npm 11.12.1 fails the vitest suite
; ("TypeError: localStorage.clear is not a function").
engine-strict=true
registry=https://registry.npmjs.org/
package-lock=true
lockfile-version=3
save-exact=true
